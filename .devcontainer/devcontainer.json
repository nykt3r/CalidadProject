{
  "name": "CalidadProject - Java + Gradle + JMeter",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "JAVA_VERSION": "23"
    }
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--network=sonarqnet"
  ],
  "remoteEnv": {
    "SONAR_HOST_URL": "http://sonarqube:9000"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic"
      }
    }
  },
  "postCreateCommand": "java -version && gradle --version && jmeter --version && node -v && openspec --version && sonar-scanner --version"
}
